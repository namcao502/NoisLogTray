# NoisLogTray configuration reference.
#
# You normally do NOT edit anything by hand. On first launch the app shows a dialog
# and stores your values in %AppData%\NoisLogTray\settings.json (under "config").
# This file only documents the available keys and their defaults; the app no longer
# reads a .env. Any missing key falls back to the process environment.

# --- Required (per user) ---
JIRA_BASE_URL=https://newoceaninfosys.atlassian.net
JIRA_EMAIL=you@company.com
JIRA_API_TOKEN=your-atlassian-api-token          # id.atlassian.com -> API tokens
HRM_API_KEY=your-hrm-api-key

# Your columns in the shared TSC workbook (comma-separated). Default: M, J
TSC_GRAPH_COLUMNS=M, J

# Daily auto-log + empty-queue reminder time. 12-hour with AM/PM. Default: 6:00 PM
LOG_TIME=6:00 PM

# --- Optional overrides (sensible defaults are built in) ---
# HRM_PROJECT_ID=
# MS_GRAPH_TOKEN=            # skips the browser token sniff if set
# TSC_GRAPH_DRIVE_ID=
# TSC_GRAPH_ITEM_ID=
# TSC_GRAPH_SHARE_URL=
# TSC_GRAPH_WORKSHEET=
