# NoisLogTray configuration template.
#
# You normally do NOT edit this file. On first launch the app shows a dialog and
# writes your values to %AppData%\NoisLogTray\.env. This file documents the keys
# and can serve as shared, non-secret defaults placed next to the exe.
#
# Precedence (later wins): app-directory .env  ->  %AppData%\NoisLogTray\.env
#                          ->  process environment.

# --- Required (per user) ---
JIRA_BASE_URL=https://newoceaninfosys.atlassian.net
JIRA_EMAIL=you@company.com
JIRA_API_TOKEN=your-atlassian-api-token          # id.atlassian.com -> API tokens
HRM_API_KEY=your-hrm-api-key

# Your columns in the shared TSC workbook (comma-separated). Default: M, J
TSC_GRAPH_COLUMNS=M, J

# --- Optional overrides (sensible defaults are built in) ---
# HRM_PROJECT_ID=
# MS_GRAPH_TOKEN=            # skips the browser token sniff if set
# TSC_GRAPH_DRIVE_ID=
# TSC_GRAPH_ITEM_ID=
# TSC_GRAPH_SHARE_URL=
# TSC_GRAPH_WORKSHEET=
