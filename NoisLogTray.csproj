<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <RootNamespace>NoisLogTray</RootNamespace>
    <AssemblyName>NoisLogTray</AssemblyName>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <!-- Base version; the release workflow overrides via -p:Version from the git tag.
         The running app compares this against the latest GitHub Release (UpdateService). -->
    <Version>1.0.0</Version>
  </PropertyGroup>

  <!-- The test and smoke projects live under this cone but build separately. -->
  <ItemGroup>
    <Compile Remove="tests\**\*.cs" />
    <Compile Remove="smoke\**\*.cs" />
  </ItemGroup>

  <!-- App icon: embedded for the tray/window, and set as the exe icon above. -->
  <ItemGroup>
    <None Remove="app.ico" />
    <EmbeddedResource Include="app.ico" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>NoisLogTray.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <!-- All runtime config lives in the per-user %AppData%\NoisLogTray\.env (written by
       the first-run dialog); the app no longer reads a .env next to the exe, so the
       project .env is never copied to output or publish and no build carries secrets.
       The template (.env.example) IS shipped so a fresh install documents the keys. -->
  <ItemGroup>
    <None Update=".env" CopyToOutputDirectory="Never" CopyToPublishDirectory="Never" />
    <None Update=".env.example" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- WebView2 pages (xterm.js and Monaco, both MIT: the Claude terminals and the Changes diff), served from the output folder. -->
  <ItemGroup>
    <None Include="Assets\**" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Microsoft's redistributable ConPTY (MIT): conpty.dll beside the exe, which starts x64\OpenConsole.exe. The inbox
       ConPTY on Windows 10 re-renders the screen, shifting claude's input line and dropping mouse modes. Copied by
       hand (the package's own targets only cover a fixed PlatformTarget) and kept out of the single-file bundle. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.Console.ConPTY" Version="1.25.260930003" GeneratePathProperty="true" ExcludeAssets="all" PrivateAssets="all" />
    <None Include="$(PkgMicrosoft_Windows_Console_ConPTY)\runtimes\win-x64\native\conpty.dll" Link="conpty.dll"
          CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" Visible="false" />
    <None Include="$(PkgMicrosoft_Windows_Console_ConPTY)\build\native\runtimes\x64\OpenConsole.exe" Link="x64\OpenConsole.exe"
          CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Playwright" Version="1.61.0" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4258.31" />
    <PackageReference Include="ModelContextProtocol" Version="2.1.0" />
  </ItemGroup>

  <!-- IncludeNativeLibrariesForSelfExtract would bundle Playwright's node.exe into the single-file exe, and Playwright
       only looks for it in .playwright\node beside the exe, so TSC sign-in fails with "driver folder missing". -->
  <Target Name="KeepPlaywrightDriverBesideExe" AfterTargets="CopyPlaywrightFilesToOutput">
    <ItemGroup>
      <Content Condition="'%(Content.NuGetPackageId)' == 'Microsoft.Playwright'">
        <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
      </Content>
    </ItemGroup>
  </Target>

  <!-- WebView2's targets always reference its WPF wrapper, which clashes with WinForms' WindowsBase (MSB3277). -->
  <Target Name="DropWebView2Wpf" BeforeTargets="ResolveAssemblyReferences">
    <ItemGroup>
      <Reference Remove="@(Reference)" Condition="'%(Filename)' == 'Microsoft.Web.WebView2.Wpf'" />
    </ItemGroup>
  </Target>

</Project>
