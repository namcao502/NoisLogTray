<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <RootNamespace>NoisLogTray</RootNamespace>
    <AssemblyName>NoisLogTray</AssemblyName>
    <ApplicationIcon>app.ico</ApplicationIcon>
  </PropertyGroup>

  <!-- The test and smoke projects live under this cone but build separately. -->
  <ItemGroup>
    <Compile Remove="tests\**\*.cs" />
    <Compile Remove="smoke\**\*.cs" />
  </ItemGroup>

  <!-- App icon: embedded for the tray/window, and set as the exe icon above. -->
  <ItemGroup>
    <None Remove="app.ico" />
    <EmbeddedResource Include="app.ico" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>NoisLogTray.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <!-- Local .env sits next to the app for `dotnet run` (dev), but must NEVER be
       distributed: excluded from publish so shared/self-contained builds carry no
       secrets. Each user supplies their own via the first-run dialog. The template
       (.env.example) IS shipped so a fresh install documents the keys. -->
  <ItemGroup>
    <None Update=".env" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Never" />
    <None Update=".env.example" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Playwright" Version="1.61.0" />
    <PackageReference Include="ModelContextProtocol" Version="2.1.0" />
  </ItemGroup>

</Project>
